---
import { studentProfile } from '../data/portfolioData';

interface Props {
  cycle: string;
}

const { cycle } = Astro.props;
---

<section class="section-spacing contact-section" id="kontak" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-card">
      <div class="contact-text-col">
        <span class="badge">Komunikasi Akademik</span>
        <h2 id="contact-title" class="contact-title">Kontak & Diskusi Pembelajaran</h2>
        <p class="contact-description">
          Portofolio ini terbuka untuk peninjauan, asesmen, dan masukan konstruktif dari Dosen Pembimbing Lapangan, Guru Pamong, serta rekan sejawat mahasiswa PPG Calon Guru. Silakan hubungi melalui saluran komunikasi profesional di bawah ini.
        </p>

        <div class="contact-channels">
          <a href={`mailto:${studentProfile.email}`} class="channel-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <div>
              <span class="channel-label">Email Akademik</span>
              <span class="channel-val">{studentProfile.email}</span>
            </div>
          </a>

          <a href={studentProfile.github} target="_blank" rel="noopener noreferrer" class="channel-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            <div>
              <span class="channel-label">Repositori Karya</span>
              <span class="channel-val">github.com/ryhnpngst</span>
            </div>
          </a>
        </div>
      </div>

      <div class="contact-summary-box">
        <h3 class="summary-box-title">Ringkasan Portofolio</h3>
        <ul class="summary-list">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Fokus Utama: <strong>{cycle}</strong></span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Perencanaan & Video Praktik terverifikasi</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Analisis Artefak Berbasis Teori Pedagogis</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Refleksi Kritis & Rencana Aksi Nyata</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card {
    background: linear-gradient(135deg, #ffffff 0%, #f4f8fd 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 899px) {
    .contact-card {
      grid-template-columns: 1.6fr 1fr;
      padding: var(--space-10);
      gap: var(--space-10);
    }
  }

  .contact-title {
    font-size: var(--text-2xl);
    color: var(--color-text);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .contact-description {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .contact-channels {
      flex-direction: row;
    }
  }

  .channel-pill {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition-fast);
  }

  .channel-pill:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }

  .channel-pill svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .channel-label {
    display: block;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-weight: var(--font-medium);
  }

  .channel-val {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-primary-active);
  }

  .contact-summary-box {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .summary-box-title {
    font-size: var(--text-base);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .summary-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .summary-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .summary-list li svg {
    color: var(--color-success);
    flex-shrink: 0;
  }
</style>

