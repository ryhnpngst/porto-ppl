---
import { studentProfile } from '../data/portfolioData';

interface Props {
  portfolioType: 'UTS' | 'UAS';
}

const { portfolioType } = Astro.props;
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isUTS = portfolioType === 'UTS';
const basePath = isUTS ? `${base}/uts` : `${base}/uas`;
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Col 1: Identity -->
      <div class="footer-col footer-col--brand">
        <div class="footer-brand">
          <span class="footer-badge">{portfolioType}</span>
          <span class="footer-title">E-Portfolio PPL Mandiri</span>
        </div>
        <p class="footer-desc">
          Dokumentasi, analisis artefak pembelajaran berbasis teori, dan refleksi evaluatif Praktik Pengalaman Lapangan (PPL) Mandiri Program PPG Calon Guru.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="footer-col">
        <h2 class="footer-heading">Navigasi Portofolio</h2>
        <ul class="footer-links">
          <li><a href={`${basePath}/`}>Beranda</a></li>
          <li><a href={`${basePath}/analisis-artefak/`}>Analisis Artefak</a></li>
          <li><a href={`${basePath}/refleksi/`}>Refleksi Pembelajaran</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} {studentProfile.name}
      </p>
      <a href="#main-content" class="back-to-top">
        <span>Kembali ke atas</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #ffffff;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    color: var(--color-text);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr auto;
      justify-content: space-between;
      align-items: start;
      gap: var(--space-12);
    }

    .footer-col--brand {
      max-width: 560px;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .footer-badge {
    background-color: var(--color-primary);
    color: #ffffff;
    font-weight: var(--font-bold);
    font-size: var(--text-xs);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .footer-title {
    font-weight: var(--font-bold);
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .footer-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .footer-heading {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .footer-bottom {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid #e8eef6;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
    }
  }

  .copyright {
    margin: 0;
  }

  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-medium);
  }

  .back-to-top:hover {
    text-decoration: underline;
  }
</style>

