---
interface Props {
  type: 'UTS' | 'UAS';
  eyebrow: string;
  title: string;
  description: string;
  cycle: string;
  topic: string;
  classLevel: string;
  school: string;
  primaryActionLabel?: string;
  primaryActionHref?: string;
  secondaryActionLabel?: string;
  secondaryActionHref?: string;
}

const {
  type,
  eyebrow,
  title,
  description,
  cycle,
  topic,
  classLevel,
  school,
  primaryActionLabel = 'Lihat Rancangan Pembelajaran',
  primaryActionHref = '#bukti-utama',
  secondaryActionLabel = 'Tonton Video Praktik',
  secondaryActionHref = '#video-praktik'
} = Astro.props;
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-card">
      <div class="hero-header">
        <div class="hero-badges">
          <span class="badge badge--primary">{type}</span>
          <span class="badge">{eyebrow}</span>
        </div>
        <h1 id="hero-title" class="hero-title">{title}</h1>
        <p class="hero-description">{description}</p>
      </div>

      <!-- Quick context metadata grid -->
      <div class="hero-meta-grid" aria-label="Informasi Konteks Pembelajaran">
        <div class="meta-item">
          <span class="meta-label">Fokus Praktik</span>
          <span class="meta-value"><strong>{cycle}</strong></span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Mata Pelajaran & Kelas</span>
          <span class="meta-value">Informatika ({classLevel})</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Topik Materi</span>
          <span class="meta-value">{topic}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Lokasi Praktik</span>
          <span class="meta-value">{school}</span>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="hero-actions">
        <a href={primaryActionHref} class="btn btn--primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>{primaryActionLabel}</span>
        </a>
        <a href={secondaryActionHref} class="btn btn--secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span>{secondaryActionLabel}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }

  .hero-card {
    background: linear-gradient(180deg, #ffffff 0%, #f4f7fc 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 768px) {
    .hero-card {
      padding: var(--space-12);
    }
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .hero-title {
    font-size: var(--text-4xl);
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: var(--reading-width);
    margin-bottom: var(--space-8);
  }

  .hero-meta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .hero-meta-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .hero-meta-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .meta-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: var(--font-medium);
  }

  .meta-value {
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
</style>

