---
interface Props {
  lessonPlan: {
    title: string;
    description: string;
    topic: string;
    classInfo: string;
    driveUrl: string;
    embedUrl: string;
  };
  teachingVideo: {
    title: string;
    description: string;
    context: string;
    duration: string;
    driveUrl: string;
    embedUrl: string;
  };
  analysisPageHref: string;
}

const { lessonPlan, teachingVideo, analysisPageHref } = Astro.props;
---

<section class="section-spacing evidence-section" id="bukti-utama" aria-labelledby="evidence-title">
  <div class="container">
    <div class="evidence-header">
      <span class="badge">Bukti Utama Praktik Mengajar</span>
      <h2 id="evidence-title" class="evidence-title">Rancangan Pembelajaran & Video Praktik</h2>
      <p class="evidence-subtitle">
        Dua artefak sentral yang menjadi dasar pelaksanaan dan evaluasi pembelajaran mandiri. Setiap produk dilengkapi preview interaktif serta akses berkas sumber asli di Google Drive.
      </p>
    </div>

    <!-- Product 1: Rancangan Pembelajaran / Modul Ajar -->
    <div class="product-block" id="rancangan-pembelajaran">
      <div class="product-content">
        <div class="product-badge-row">
          <span class="product-number">Produk 01</span>
          <span class="badge">Perencanaan Pembelajaran</span>
        </div>
        <h3 class="product-title">{lessonPlan.title}</h3>
        <p class="product-desc">{lessonPlan.description}</p>

        <div class="product-meta-row">
          <div class="meta-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>Topik: <strong>{lessonPlan.topic}</strong></span>
          </div>
          <div class="meta-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>{lessonPlan.classInfo}</span>
          </div>
        </div>

        <div class="product-actions">
          <a href={lessonPlan.driveUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            <span>Buka Dokumen di Google Drive</span>
          </a>
          <a href={analysisPageHref} class="btn btn--outline">
            <span>Baca Analisis RPP</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <!-- Preview Frame -->
      <div class="product-preview-box">
        <div class="preview-header">
          <span class="preview-dot dot-red"></span>
          <span class="preview-dot dot-yellow"></span>
          <span class="preview-dot dot-green"></span>
          <span class="preview-label">Preview Dokumen Perencanaan (Google Drive)</span>
        </div>
        <div class="embed-frame">
          <iframe
            src={lessonPlan.embedUrl}
            title={`Preview Dokumen ${lessonPlan.title}`}
            loading="lazy"
            allow="autoplay"
          ></iframe>
        </div>
        <div class="preview-footer">
          <span class="fallback-text">
            Kendala memuat preview? Dokumen dapat langsung diakses via
            <a href={lessonPlan.driveUrl} target="_blank" rel="noopener noreferrer">Tautan Google Drive Cadangan</a>.
          </span>
        </div>
      </div>
    </div>

    <!-- Product 2: Video Pelaksanaan Pembelajaran -->
    <div class="product-block product-block--video" id="video-praktik">
      <div class="product-content">
        <div class="product-badge-row">
          <span class="product-number">Produk 02</span>
          <span class="badge">Video Pelaksanaan</span>
        </div>
        <h3 class="product-title">{teachingVideo.title}</h3>
        <p class="product-desc">{teachingVideo.description}</p>

        <div class="product-meta-row">
          <div class="meta-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{teachingVideo.duration}</span>
          </div>
          <div class="meta-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>{teachingVideo.context}</span>
          </div>
        </div>

        <div class="product-actions">
          <a href={teachingVideo.driveUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span>Tonton di Google Drive</span>
          </a>
          <a href={analysisPageHref} class="btn btn--outline">
            <span>Baca Analisis Video</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <div class="video-notice">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <span>Video ini menyajikan interaksi pembelajaran aktif murid dengan tetap menjaga anonimitas identitas peserta didik.</span>
        </div>
      </div>

      <!-- Video Preview Frame -->
      <div class="product-preview-box">
        <div class="preview-header">
          <span class="preview-dot dot-red"></span>
          <span class="preview-dot dot-yellow"></span>
          <span class="preview-dot dot-green"></span>
          <span class="preview-label">Player Rekaman Praktik Pembelajaran</span>
        </div>
        <div class="embed-frame embed-frame--video">
          <iframe
            src={teachingVideo.embedUrl}
            title={`Preview Video ${teachingVideo.title}`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <div class="preview-footer">
          <span class="fallback-text">
            Bila video tidak berputar otomatis, silakan buka langsung di
            <a href={teachingVideo.driveUrl} target="_blank" rel="noopener noreferrer">Repositori Google Drive Video</a>.
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .evidence-header {
    margin-bottom: var(--space-10);
    max-width: var(--reading-width);
  }

  .evidence-title {
    font-size: var(--text-3xl);
    color: var(--color-text);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .evidence-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0;
  }

  .product-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-10);
    align-items: start;
  }

  @media (min-width: 992px) {
    .product-block {
      grid-template-columns: 1.1fr 1.4fr;
      padding: var(--space-8);
      gap: var(--space-10);
    }
  }

  .product-badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .product-number {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .product-title {
    font-size: var(--text-2xl);
    color: var(--color-text);
    margin-bottom: var(--space-3);
    line-height: 1.3;
  }

  .product-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .product-meta-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    background-color: #f7f9fc;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .meta-tag {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .meta-tag svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .product-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .video-notice {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background-color: #f1f5fa;
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    margin-top: var(--space-4);
    line-height: 1.5;
  }

  .video-notice svg {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Preview Frame Wrapper */
  .product-preview-box {
    background-color: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .preview-header {
    background-color: #e9eef6;
    padding: var(--space-2) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .preview-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background-color: #f87171; }
  .dot-yellow { background-color: #fbbf24; }
  .dot-green { background-color: #34d399; }

  .preview-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: var(--font-medium);
    margin-left: var(--space-2);
  }

  .preview-footer {
    padding: var(--space-3) var(--space-4);
    background-color: #ffffff;
    border-top: 1px solid var(--color-border);
  }

  .fallback-text {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    display: block;
    line-height: 1.5;
  }
</style>

