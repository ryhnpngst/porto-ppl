---
import { studentProfile } from '../data/portfolioData';

interface Props {
  cycle: string;
}

const { cycle } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section-spacing profile-section" id="profil" aria-labelledby="profile-title">
  <div class="container">
    <div class="card profile-card">
      <div class="profile-layout">
        <!-- Foto Profil di Sebelah Kiri -->
        <div class="profile-avatar-col">
          <img
            src={`${base}/images/profile/profile.png`}
            alt={`Foto Profil ${studentProfile.name}`}
            class="profile-img"
            loading="lazy"
          />
        </div>

        <!-- Kolom Informasi di Sebelah Kanan -->
        <div class="profile-info-col">
          <div class="profile-header">
            <div>
              <span class="badge">Profil Mahasiswa</span>
              <h2 id="profile-title" class="profile-name">{studentProfile.name}</h2>
              <p class="profile-subtitle">
                {studentProfile.program} • {studentProfile.studyProgram}
              </p>
            </div>
          </div>

          <p class="profile-bio">
            {studentProfile.bio}
          </p>

          <div class="academic-details-grid">
            <div class="academic-detail">
              <span class="detail-label">Institusi Penyelenggara</span>
              <span class="detail-value">{studentProfile.university}</span>
            </div>
            <div class="academic-detail">
              <span class="detail-label">Sekolah Praktik (PPL)</span>
              <span class="detail-value">{studentProfile.school}</span>
            </div>
            <div class="academic-detail">
              <span class="detail-label">Tahapan Portofolio</span>
              <span class="detail-value">Praktik Mengajar Mandiri ({cycle})</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-section {
    padding-top: var(--space-8);
  }

  .profile-card {
    padding: var(--space-8);
    background-color: #ffffff;
  }

  @media (min-width: 768px) {
    .profile-card {
      padding: var(--space-10);
    }
  }

  .profile-layout {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .profile-layout {
      flex-direction: row;
      align-items: stretch;
      gap: var(--space-8);
    }
  }

  @media (min-width: 992px) {
    .profile-layout {
      gap: var(--space-10);
    }
  }

  .profile-avatar-col {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
  }

  .profile-img {
    width: 220px;
    height: 100%;
    min-height: 320px;
    max-height: 380px;
    border-radius: var(--radius-md);
    object-fit: cover;
    object-position: top center;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border);
    display: block;
  }

  @media (max-width: 899px) {
    .profile-img {
      width: 190px;
      min-height: 280px;
      max-height: 340px;
    }
  }

  @media (max-width: 639px) {
    .profile-img {
      width: 100%;
      max-width: 220px;
      min-height: 240px;
      height: auto;
    }
  }

  .profile-info-col {
    flex: 1;
    min-width: 0;
  }

  .profile-header {
    margin-bottom: var(--space-4);
  }

  .profile-name {
    font-size: var(--text-2xl);
    color: var(--color-text);
    margin-top: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .profile-subtitle {
    font-size: var(--text-sm);
    color: var(--color-primary);
    font-weight: var(--font-medium);
    margin-bottom: 0;
  }

  .profile-bio {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-6);
    max-width: var(--reading-width);
  }

  .academic-details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    background-color: #f7f9fc;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .academic-details-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .academic-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .detail-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .detail-value {
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: var(--font-medium);
  }
</style>
