---
import { studentProfile } from '../data/portfolioData';

interface Props {
  cycle: string;
}

const { cycle } = Astro.props;
---

<section class="section-spacing profile-section" id="profil" aria-labelledby="profile-title">
  <div class="container">
    <div class="card profile-card">
      <div class="profile-layout">
        <!-- Avatar / Initial badge -->
        <div class="profile-avatar-col">
          <div class="avatar-circle" aria-hidden="true">
            <span class="avatar-initials">RP</span>
          </div>
          <span class="avatar-tag">Calon Guru Informatika</span>
        </div>

        <!-- Details -->
        <div class="profile-info-col">
          <div class="profile-header">
            <div>
              <span class="badge">Profil Mahasiswa</span>
              <h2 id="profile-title" class="profile-name">{studentProfile.name}</h2>
              <p class="profile-subtitle">
                {studentProfile.program} • {studentProfile.studyProgram}
              </p>
            </div>
          </div>

          <p class="profile-bio">
            {studentProfile.bio}
          </p>

          <div class="academic-details-grid">
            <div class="academic-detail">
              <span class="detail-label">Institusi Penyelenggara</span>
              <span class="detail-value">{studentProfile.university}</span>
            </div>
            <div class="academic-detail">
              <span class="detail-label">Sekolah Praktik (PPL)</span>
              <span class="detail-value">{studentProfile.school}</span>
            </div>
            <div class="academic-detail">
              <span class="detail-label">Tahapan Portofolio</span>
              <span class="detail-value">Praktik Mengajar Mandiri ({cycle})</span>
            </div>
          </div>

          <!-- Focus Areas -->
          <div class="focus-areas-group">
            <h3 class="focus-title">Fokus & Pendekatan Pedagogis</h3>
            <div class="focus-chips">
              {studentProfile.focusAreas.map((area) => (
                <span class="focus-chip">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>{area}</span>
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-section {
    padding-top: var(--space-8);
  }

  .profile-card {
    padding: var(--space-8);
    background-color: #ffffff;
  }

  @media (min-width: 768px) {
    .profile-card {
      padding: var(--space-10);
    }
  }

  .profile-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .profile-layout {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-10);
    }
  }

  .profile-avatar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .avatar-circle {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-active) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    border: 4px solid var(--color-primary-light);
    box-shadow: var(--shadow-card);
  }

  .avatar-initials {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    letter-spacing: 0.05em;
  }

  .avatar-tag {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--color-text-muted);
    text-align: center;
  }

  .profile-info-col {
    flex: 1;
  }

  .profile-header {
    margin-bottom: var(--space-4);
  }

  .profile-name {
    font-size: var(--text-2xl);
    color: var(--color-text);
    margin-top: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .profile-subtitle {
    font-size: var(--text-sm);
    color: var(--color-primary);
    font-weight: var(--font-medium);
    margin-bottom: 0;
  }

  .profile-bio {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-6);
    max-width: var(--reading-width);
  }

  .academic-details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    background-color: #f7f9fc;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .academic-details-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .academic-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .detail-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .detail-value {
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: var(--font-medium);
  }

  .focus-areas-group {
    margin-top: var(--space-4);
  }

  .focus-title {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .focus-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .focus-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.75rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    color: var(--color-text);
    font-weight: var(--font-medium);
  }

  .focus-chip svg {
    color: var(--color-primary);
  }
</style>

