---
interface Props {
  title: string;
  category: string;
  description: string;
  context: string;
  driveUrl: string;
  analysisHref: string;
}

const { title, category, description, context, driveUrl, analysisHref } = Astro.props;
---

<div class="card artifact-card">
  <div class="card-top">
    <span class="badge">{category}</span>
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>
  <div class="card-context">
    <span class="context-label">Peran dalam Pembelajaran:</span>
    <p class="context-text">{context}</p>
  </div>
  <div class="card-actions">
    <a href={analysisHref} class="btn btn--outline card-btn">
      <span>Baca Analisis Kritis</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
    <a href={driveUrl} target="_blank" rel="noopener noreferrer" class="drive-link" title="Buka berkas di Google Drive">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
      <span>Google Drive</span>
    </a>
  </div>
</div>

<style>
  .artifact-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: #ffffff;
    height: 100%;
  }

  .card-top {
    margin-bottom: var(--space-3);
  }

  .card-title {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-bottom: var(--space-2);
    line-height: 1.35;
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .card-context {
    background-color: #f7f9fc;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .context-label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }

  .context-text {
    font-size: var(--text-xs);
    color: var(--color-text);
    margin: 0;
    line-height: 1.5;
  }

  .card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid #edf2f7;
  }

  .card-btn {
    font-size: var(--text-xs);
    padding: 0.4rem 0.85rem;
  }

  .drive-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .drive-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>

