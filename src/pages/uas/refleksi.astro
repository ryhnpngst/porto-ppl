---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { uasPortfolio, studentProfile } from '../../data/portfolioData';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const berandaHref = `${base}/uas/`;
const analisisHref = `${base}/uas/analisis-artefak/`;
---

<PortfolioLayout
  title={`Refleksi Pembelajaran • ${uasPortfolio.title}`}
  description="Refleksi profesional calon guru mencakup model guru yang dituju, filosofi mengajar, dan rencana tindak lanjut Praktik Mengajar Mandiri Siklus 3."
  portfolioType="UAS"
  activePage="refleksi"
>
  <div class="container section-spacing">
    <!-- Header Halaman -->
    <header class="reflection-header">
      <div class="header-badges">
        <span class="badge badge--primary">UAS • Siklus 3</span>
        <span class="badge">Refleksi Profesional Guru</span>
      </div>
      <h1 class="page-title">Refleksi Pembelajaran</h1>
      <p class="page-desc">
        Kajian reflektif komprehensif atas pelaksanaan Praktik Pengalaman Lapangan (PPL) Mandiri Siklus 3 di {studentProfile.school}. Memuat konstruksi identitas profesional, landasan filosofi pendidikan, serta rencana tindak lanjut pengembangan keprofesian berkelanjutan.
      </p>
    </header>

    <!-- Konten Utama: 3 Bagian Refleksi -->
    <div class="reflection-stack">
      <!-- 1. Refleksi Model Guru yang Dituju -->
      <article class="card reflection-card" id="model-guru">
        <div class="card-header">
          <div class="icon-badge">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <div>
            <span class="card-eyebrow">Bagian 01</span>
            <h2 class="card-title">Refleksi Model Guru yang Dituju</h2>
          </div>
        </div>

        <div class="card-body">
          <p class="reflection-paragraph">
            Saya ingin menjadi guru yang profesional, reflektif, inspiratif, dan adaptif terhadap perkembangan zaman. Bagi saya, guru tidak hanya bertugas menyampaikan materi, tetapi juga menjadi fasilitator dan pembimbing yang mampu memahami kebutuhan, potensi, serta karakteristik murid. Melalui pengalaman PPL Mandiri, saya menyadari bahwa setiap murid memiliki kemampuan dan tingkat kepercayaan diri yang berbeda sehingga membutuhkan pendekatan pembelajaran yang sesuai. Oleh karena itu, saya ingin menciptakan pembelajaran yang aktif, menyenangkan, dan bermakna, serta mendorong murid untuk berani mencoba, belajar dari kesalahan, dan terus mengembangkan potensinya.
          </p>

          <div class="highlight-tags">
            <span class="highlight-tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Profesional & Berkompeten
            </span>
            <span class="highlight-tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Reflektif & Terbuka Evaluasi
            </span>
            <span class="highlight-tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Inspiratif & Membangun Percaya Diri
            </span>
            <span class="highlight-tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Adaptif terhadap Perkembangan Zaman
            </span>
          </div>
        </div>
      </article>

      <!-- 2. Refleksi Filosofi Mengajar -->
      <article class="card reflection-card" id="filosofi-mengajar">
        <div class="card-header">
          <div class="icon-badge">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
          </div>
          <div>
            <span class="card-eyebrow">Bagian 02</span>
            <h2 class="card-title">Refleksi Filosofi Mengajar</h2>
          </div>
        </div>

        <div class="card-body">
          <p class="reflection-paragraph">
            Pengalaman PPL Mandiri mengubah pandangan saya bahwa keberhasilan mengajar tidak hanya diukur dari ketercapaian materi dan hasil akhir, tetapi juga dari proses perkembangan murid. Filosofi Ki Hadjar Dewantara tentang pendidikan sebagai tuntunan menjadi landasan bagi saya untuk mendampingi murid sesuai potensi dan karakteristiknya. Dalam proses pembelajaran, kesalahan yang terjadi selama eksplorasi dan pengerjaan tugas dapat menjadi kesempatan untuk belajar, mengevaluasi, dan memperbaiki hasil. Saya juga memahami pentingnya menanamkan nilai disiplin, tanggung jawab, kerja sama, dan saling menghargai. Dengan demikian, mengajar bagi saya merupakan proses mendampingi murid agar berkembang menjadi pribadi yang mandiri, berkarakter, kompeten, dan mampu belajar sepanjang hayat.
          </p>

          <div class="quote-panel">
            <div class="quote-icon" aria-hidden="true">“</div>
            <p class="quote-text">
              Pendidikan sebagai <strong>tuntunan</strong> bagi segala kodrat anak, agar mereka sebagai manusia dan anggota masyarakat dapat mencapai keselamatan dan kebahagiaan setinggi-tingginya.
            </p>
            <span class="quote-author">— Intisari Filosofi Pendidikan Ki Hadjar Dewantara</span>
          </div>
        </div>
      </article>

      <!-- 3. Rencana Tindak Lanjut -->
      <article class="card reflection-card" id="rencana-tindak-lanjut">
        <div class="card-header">
          <div class="icon-badge">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 14 14"></polyline>
            </svg>
          </div>
          <div>
            <span class="card-eyebrow">Bagian 03</span>
            <h2 class="card-title">Rencana Tindak Lanjut</h2>
          </div>
        </div>

        <div class="card-body">
          <p class="reflection-paragraph">
            Berdasarkan pengalaman selama PPL Mandiri, saya perlu terus meningkatkan kemampuan dalam merencanakan pembelajaran, mengelola waktu praktik, dan memastikan keterlibatan seluruh murid. Saya akan menyusun kegiatan pembelajaran yang lebih terstruktur, memberikan demonstrasi dan pendampingan sesuai kebutuhan, serta mengembangkan media pembelajaran interaktif yang relevan dengan kompetensi Informatika. Selain itu, saya akan memperkuat instrumen asesmen agar dapat menilai aspek pengetahuan, keterampilan, dan sikap secara menyeluruh. Saya juga akan membiasakan diri melakukan refleksi setelah pembelajaran, menerima masukan dari guru pamong dan rekan sejawat, serta menggunakan hasil evaluasi sebagai dasar perbaikan. Melalui langkah tersebut, saya berharap dapat menjadi guru yang terus berkembang dan mampu menghadirkan pembelajaran yang berpusat pada murid serta sesuai dengan tuntutan zaman.
          </p>

          <div class="action-steps-grid">
            <div class="step-card">
              <span class="step-num">01</span>
              <h3 class="step-title">Perencanaan & Manajemen Waktu</h3>
              <p class="step-desc">
                Menyusun alur aktivitas pembelajaran yang terstruktur dengan estimasi waktu yang lebih presisi saat sesi praktik dan pendampingan kelompok.
              </p>
            </div>
            <div class="step-card">
              <span class="step-num">02</span>
              <h3 class="step-title">Media Pembelajaran Interaktif</h3>
              <p class="step-desc">
                Mengembangkan demonstrasi dan media digital interaktif yang relevan guna memperkuat pemahaman konsep komputasi bagi murid.
              </p>
            </div>
            <div class="step-card">
              <span class="step-num">03</span>
              <h3 class="step-title">Asesmen Komprehensif</h3>
              <p class="step-desc">
                Memperkuat instrumen penilaian autentik yang mengukur aspek pengetahuan (kognitif), keterampilan (psikomotorik), dan sikap (afektif).
              </p>
            </div>
            <div class="step-card">
              <span class="step-num">04</span>
              <h3 class="step-title">Kultur Refleksi Berkelanjutan</h3>
              <p class="step-desc">
                Membiasakan evaluasi diri mandiri dan aktif berkolaborasi dengan guru pamong serta rekan sejawat demi peningkatan mutu pengajaran.
              </p>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- Navigasi Bawah Antarhalaman -->
    <nav class="reflection-bottom-nav" aria-label="Navigasi Halaman Portofolio">
      <a href={berandaHref} class="btn btn--outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Kembali ke Beranda UAS</span>
      </a>

      <a href={analisisHref} class="btn btn--primary">
        <span>Menuju Analisis Artefak</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </nav>
  </div>
</PortfolioLayout>

<style>
  .reflection-header {
    max-width: var(--reading-width);
    margin-bottom: var(--space-10);
  }

  .header-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .page-title {
    font-size: var(--text-4xl);
    color: var(--color-text);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
    letter-spacing: -0.02em;
  }

  .page-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .reflection-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .reflection-card {
    padding: var(--space-8);
    background-color: var(--color-surface);
  }

  @media (min-width: 768px) {
    .reflection-card {
      padding: var(--space-10);
    }
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .icon-badge {
    width: 48px;
    height: 48px;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    display: block;
    margin-bottom: 2px;
  }

  .card-title {
    font-size: var(--text-2xl);
    color: var(--color-text);
    margin: 0;
  }

  .reflection-paragraph {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.8;
    max-width: var(--reading-width);
    margin-bottom: var(--space-6);
    text-align: justify;
  }

  /* Highlight Tags */
  .highlight-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .highlight-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem 0.85rem;
    background-color: #f7f9fc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--color-text);
  }

  .highlight-tag svg {
    color: var(--color-primary);
  }

  /* Quote Panel */
  .quote-panel {
    background-color: #f6f9fd;
    border-left: 4px solid var(--color-primary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--space-6) var(--space-8);
    position: relative;
    max-width: var(--reading-width);
  }

  .quote-icon {
    position: absolute;
    top: var(--space-2);
    left: var(--space-3);
    font-size: 3rem;
    line-height: 1;
    color: var(--color-primary-light);
    font-family: serif;
    pointer-events: none;
  }

  .quote-text {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: var(--space-2);
    font-style: italic;
    position: relative;
    z-index: 1;
  }

  .quote-author {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
  }

  /* Action Steps Grid */
  .action-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .action-steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .step-card {
    background-color: #f7f9fc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
  }

  .step-num {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    width: fit-content;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
  }

  .step-title {
    font-size: var(--text-base);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .step-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Bottom Navigation */
  .reflection-bottom-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .reflection-bottom-nav {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
