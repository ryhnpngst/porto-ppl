---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { uasPortfolio } from '../../data/portfolioData';
---

<PortfolioLayout
  title={`Refleksi Pembelajaran • ${uasPortfolio.title}`}
  description="Halaman refleksi profesional calon guru, evaluasi efektivitas pembelajaran, dan rencana tindak lanjut Siklus Terpilih (Siklus 2)."
  portfolioType="UAS"
  activePage="refleksi"
>
  <div class="container section-spacing">
    <div class="page-header">
      <span class="badge">Tahap Selanjutnya</span>
      <h1 class="page-title">Refleksi Pembelajaran — Siklus Terpilih (Siklus 2)</h1>
      <p class="page-desc">
        Halaman ini disiapkan untuk menyajikan refleksi profesional komprehensif calon guru yang menguraikan evaluasi proses pembelajaran berbasis proyek, perkembangan kompetensi guru, serta rencana pengembangan keprofesian berkelanjutan (PKB).
      </p>
    </div>

    <div class="card placeholder-card">
      <div class="placeholder-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 14 14"></polyline>
        </svg>
      </div>
      <h2 class="placeholder-heading">Struktur Refleksi Guru (PRD Tahap 5)</h2>
      <p class="placeholder-text">
        Refleksi akan mendokumentasikan model guru yang dituju pasca-PPL, sintesis filosofi pedagogis Informatika, perbandingan peningkatan kualitas mengajar antarsiklus, serta tindak lanjut konkrit untuk praktik mengajar di sekolah masa depan.
      </p>
      <div class="placeholder-actions">
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/uas/`} class="btn btn--primary">
          ← Kembali ke Beranda UAS
        </a>
      </div>
    </div>
  </div>
</PortfolioLayout>

<style>
  .page-header {
    max-width: var(--reading-width);
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-size: var(--text-3xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .page-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .placeholder-card {
    text-align: center;
    padding: var(--space-12) var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 680px;
    margin-inline: auto;
  }

  .placeholder-icon {
    width: 72px;
    height: 72px;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .placeholder-heading {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .placeholder-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .placeholder-actions {
    display: flex;
    justify-content: center;
  }
</style>

