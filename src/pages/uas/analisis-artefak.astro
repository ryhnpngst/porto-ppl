<script is:inline>
  function setupArtifactTabs() {
    const tabRppBtn = document.getElementById('tab-btn-rpp');
    const tabMateriBtn = document.getElementById('tab-btn-materi');
    const tabLkpdBtn = document.getElementById('tab-btn-lkpd');

    const panelRpp = document.getElementById('panel-rpp');
    const panelMateri = document.getElementById('panel-materi');
    const panelLkpd = document.getElementById('panel-lkpd');

    const switchToRppBtns = document.querySelectorAll('.switch-to-rpp-btn');
    const switchToMateriBtns = document.querySelectorAll('.switch-to-materi-btn');
    const switchToLkpdBtns = document.querySelectorAll('.switch-to-lkpd-btn');

    function switchTab(target) {
      // Deactivate all
      tabRppBtn?.classList.remove('active');
      tabRppBtn?.setAttribute('aria-selected', 'false');
      tabMateriBtn?.classList.remove('active');
      tabMateriBtn?.setAttribute('aria-selected', 'false');
      tabLkpdBtn?.classList.remove('active');
      tabLkpdBtn?.setAttribute('aria-selected', 'false');

      panelRpp?.classList.remove('active');
      panelMateri?.classList.remove('active');
      panelLkpd?.classList.remove('active');

      if (target === 'lkpd') {
        tabLkpdBtn?.classList.add('active');
        tabLkpdBtn?.setAttribute('aria-selected', 'true');
        panelLkpd?.classList.add('active');
      } else if (target === 'materi') {
        tabMateriBtn?.classList.add('active');
        tabMateriBtn?.setAttribute('aria-selected', 'true');
        panelMateri?.classList.add('active');
      } else {
        tabRppBtn?.classList.add('active');
        tabRppBtn?.setAttribute('aria-selected', 'true');
        panelRpp?.classList.add('active');
      }
    }

    tabRppBtn?.addEventListener('click', () => {
      switchTab('rpp');
      history.replaceState(null, '', '#analisis-rpp');
    });

    tabMateriBtn?.addEventListener('click', () => {
      switchTab('materi');
      history.replaceState(null, '', '#analisis-materi');
    });

    tabLkpdBtn?.addEventListener('click', () => {
      switchTab('lkpd');
      history.replaceState(null, '', '#analisis-lkpd');
    });

    switchToRppBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        switchTab('rpp');
        history.replaceState(null, '', '#analisis-rpp');
        document.getElementById('identitas-rpp')?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    switchToMateriBtns.forEach((btn) => {
